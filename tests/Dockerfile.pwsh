# Docker PowerShell 回归测试镜像（FENIX_TEST_DOCKER_PWSH=1）
# 构建：docker build -t fenix-selected-skills-pwsh:test -f tests/Dockerfile.pwsh tests
# 说明：官方 powershell 镜像不含 git / jq / curl，而安装器依赖它们。
FROM mcr.microsoft.com/powershell:7.4-debian-12

RUN apt-get update \
    && apt-get install -y --no-install-recommends git jq curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*